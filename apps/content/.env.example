# Variáveis de ambiente para apps/content (Astro SSG)
# Copie para .env e preencha os valores reais.
# Nunca commite o arquivo .env.

# Google Analytics 4 — Measurement ID
# Obtido em: Analytics > Configurações do stream > ID de medição
PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console — verificação de propriedade
# Obtido em: Search Console > Verificar propriedade > Tag HTML > content
PUBLIC_GOOGLE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bing Webmaster Tools — verificação de propriedade via meta tag
# Obtido em: Bing Webmaster > Adicionar site > Meta tag > content
PUBLIC_BING_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
