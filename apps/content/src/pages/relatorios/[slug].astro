---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { RELATORIOS } from '../../data/relatorios';
import { IMOVEIS_CIDADE, hasImoveisData } from '../../data/imoveis_aggregates';

export const getStaticPaths: GetStaticPaths = () =>
  RELATORIOS.map((r) => ({ params: { slug: r.slug }, props: { relatorio: r } }));

const { relatorio: r } = Astro.props;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: r.titulo,
    description: r.resumoExecutivo.slice(0, 200),
    datePublished: r.dataPublicacao,
    dateModified: r.dataPublicacao,
    author: { '@type': 'Organization', name: 'BetterPlace' },
    publisher: { '@type': 'Organization', name: 'BetterPlace', url: 'https://www.betterplace.com.br' },
    url: `https://www.betterplace.com.br/relatorios/${r.slug}`,
    about: { '@type': 'Dataset', name: 'BetterPlace — Qualidade Urbana por Distrito (São Paulo)' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Quais distritos foram analisados neste relatório?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${r.totalDistritosAnalisados} distritos municipais de São Paulo com dados do pipeline GeoSampa. A cobertura será expandida nas próximas edições.`,
        },
      },
      {
        '@type': 'Question',
        name: 'Os dados de segurança são confiáveis?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Os dados de segurança (SSP-SP) têm cobertura parcial em todos os distritos — sub-registro estrutural é uma limitação inerente dos dados de boletins de ocorrência. Os scores indicam densidade relativa, não nível absoluto de segurança.',
        },
      },
    ],
  },
];
---

<Base
  title={`${r.titulo} · BetterPlace`}
  description={r.resumoExecutivo.slice(0, 155) + '…'}
  dateModified={r.dataPublicacao}
  jsonLd={jsonLd}
  ogType="article"
  breadcrumbs={[
    { name: 'Início', url: '/' },
    { name: 'Relatórios', url: '/relatorios' },
    { name: r.periodo },
  ]}
>
  <span class="tag">Relatório · {r.periodo}</span>
  <h1>{r.titulo}</h1>
  <p class="meta">
    Publicado em {r.dataPublicacao} ·
    {r.totalDistritosAnalisados} distritos analisados ·
    <a href="/metodologia">Metodologia</a> ·
    <a href="/dados">Dataset aberto</a>
  </p>

  <h2>Resumo executivo</h2>
  <p class="lead">{r.resumoExecutivo}</p>

  <div class="export-links">
    <strong>Downloads desta edição:</strong>
    <a
      href={r.csvPath}
      download
      data-event="report_download"
      data-format="csv"
      data-slug={r.slug}
    >CSV</a>
    <a
      href={r.jsonPath}
      download
      data-event="report_download"
      data-format="json"
      data-slug={r.slug}
    >JSON</a>
  </div>

  <Cta tipo="relatorio" posicao="mid" slug={r.slug} />

  <hr class="divider" />

  <h2>Rankings por métrica</h2>
  <p class="meta">
    Scores normalizados de 0 a 100 entre os {r.totalDistritosAnalisados} distritos analisados.
    Flood risk e segurança são invertidos: score maior = menor exposição/ocorrência relativa.
  </p>

  {r.rankingsPorMetrica.map((ranking) => (
    <div class="ranking-block">
      <h3>{ranking.label}</h3>
      <p class="meta">{ranking.nota}</p>
      <ol class="ranking-list">
        {ranking.top.map((item, i) => (
          <li class="ranking-item">
            <span class="ranking-pos">{i + 1}.º</span>
            <div class="ranking-bar-wrap">
              <a href={`/bairros/${item.slug}`} class="ranking-name">{item.nome}</a>
              <div class="ranking-bar-track">
                <div class="ranking-bar-fill" style={`width:${item.score}%`}></div>
              </div>
            </div>
            <span class="ranking-score">{item.score}/100</span>
          </li>
        ))}
      </ol>
    </div>
  ))}

  <hr class="divider" />

  <h2>Principais mudanças</h2>
  <ul>
    {r.principaisMudancas.map((m) => <li>{m}</li>)}
  </ul>

  {hasImoveisData() && IMOVEIS_CIDADE != null && (
    <>
      <hr class="divider" />
      <h2>Panorama imobiliário — São Paulo</h2>
      <p class="meta">
        Base interna BetterPlace · {IMOVEIS_CIDADE.dataAtualizacao} ·{' '}
        <a href="/metodologia#dados-imobiliarios">Metodologia</a>
      </p>
      <div class="imoveis-stats">
        <div class="imoveis-stat">
          <span class="imoveis-label">Distritos com dados</span>
          <strong class="imoveis-value">{IMOVEIS_CIDADE.totalBairros}</strong>
        </div>
        <div class="imoveis-stat">
          <span class="imoveis-label">Imóveis elegíveis</span>
          <strong class="imoveis-value">{IMOVEIS_CIDADE.totalImoveisElegiveis.toLocaleString('pt-BR')}</strong>
        </div>
        {IMOVEIS_CIDADE.medianaAluguelM2 != null && (
          <div class="imoveis-stat">
            <span class="imoveis-label">Mediana aluguel/m²</span>
            <strong class="imoveis-value">
              R$ {IMOVEIS_CIDADE.medianaAluguelM2.toFixed(2).replace('.', ',')}
            </strong>
          </div>
        )}
        {IMOVEIS_CIDADE.medianaVendaM2 != null && (
          <div class="imoveis-stat">
            <span class="imoveis-label">Mediana venda/m²</span>
            <strong class="imoveis-value">
              R$ {IMOVEIS_CIDADE.medianaVendaM2.toFixed(2).replace('.', ',')}
            </strong>
          </div>
        )}
      </div>
      <p class="meta"><a href="/imoveis/sp">Ver panorama imobiliário completo →</a></p>
    </>
  )}

  <hr class="divider" />

  <h2>Achados desta edição</h2>
  {r.achados.map((a) => (
    <div class="achado-block">
      <strong>{a.titulo}</strong>
      <p>{a.descricao}</p>
    </div>
  ))}

  <Cta tipo="relatorio" posicao="inline" slug={r.slug} />

  <hr class="divider" />

  <h2>Limitações metodológicas</h2>
  <ul>
    {r.limitacoes.map((l) => <li>{l}</li>)}
  </ul>

  <h2>Fontes e dataset</h2>
  <ul>
    <li><a href="/metodologia">Metodologia completa — fontes, agregações e critérios</a></li>
    <li><a href="/dados">Dataset aberto — CSV, JSON e GeoJSON para download</a></li>
    <li>
      Download desta edição:
      <a href={r.csvPath} download data-event="report_download" data-format="csv" data-slug={r.slug}>CSV</a> ·
      <a href={r.jsonPath} download data-event="report_download" data-format="json" data-slug={r.slug}>JSON</a>
    </li>
  </ul>

  <hr class="divider" />

  <h2>Perguntas frequentes</h2>

  <h3>Quais distritos foram analisados neste relatório?</h3>
  <p>
    {r.totalDistritosAnalisados} distritos municipais de São Paulo com dados do pipeline GeoSampa.
    A cobertura será expandida nas próximas edições.
  </p>

  <h3>Os dados de segurança são confiáveis?</h3>
  <p>
    Os dados de segurança (SSP-SP) têm cobertura parcial em todos os distritos — sub-registro
    estrutural é uma limitação inerente. Os scores indicam densidade relativa de boletins de
    ocorrência por km², não nível absoluto de segurança.
  </p>

  <hr class="divider" />

  <p class="meta">
    Metodologia: <a href="/metodologia">como os dados são calculados</a> ·
    Dataset: <a href="/dados">download completo</a> ·
    Publicado em {r.dataPublicacao}
  </p>

  <Cta tipo="relatorio" posicao="end" slug={r.slug} />
</Base>

<style>
  .export-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-surface, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 6px;
    padding: 0.65rem 1rem;
    font-size: 0.9rem;
    margin: 1rem 0 1.5rem;
  }
  .export-links a {
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    background: var(--color-accent, #2563eb);
    color: #fff;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.82rem;
    transition: opacity 0.15s;
  }
  .export-links a:hover { opacity: 0.85; text-decoration: none; }

  .ranking-block {
    margin: 1.5rem 0;
  }
  .ranking-block h3 { margin-bottom: 0.2rem; }

  .ranking-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .ranking-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-surface, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 5px;
    font-size: 0.92rem;
  }
  .ranking-pos {
    font-weight: 700;
    color: var(--color-muted, #64748b);
    min-width: 2rem;
  }
  .ranking-bar-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .ranking-name { font-weight: 500; }
  .ranking-bar-track {
    height: 6px;
    background: var(--color-border, #e2e8f0);
    border-radius: 3px;
    overflow: hidden;
  }
  .ranking-bar-fill {
    height: 100%;
    background: var(--color-accent, #2563eb);
    border-radius: 3px;
    transition: width 0.3s;
  }
  .ranking-score {
    font-weight: 700;
    color: var(--color-accent, #2563eb);
    min-width: 4.5rem;
    text-align: right;
    font-size: 0.88rem;
  }

  .achado-block {
    background: var(--color-surface, #f8fafc);
    border-left: 4px solid var(--color-accent, #2563eb);
    padding: 0.75rem 1rem;
    border-radius: 4px;
    margin: 1rem 0;
    font-size: 0.93rem;
  }
  .achado-block strong { display: block; margin-bottom: 0.3rem; }
  .achado-block p { margin: 0; }

  .imoveis-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0;
  }
  .imoveis-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: var(--color-surface, #f8fafc);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 6px;
    padding: 0.65rem 1rem;
    min-width: 10rem;
  }
  .imoveis-label {
    font-size: 0.78rem;
    color: var(--color-muted, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .imoveis-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent, #2563eb);
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-event="report_download"]').forEach((el) => {
    el.addEventListener('click', () => {
      const eventName = el.dataset.event ?? 'report_download';
      if (typeof (window as any).gtag !== 'undefined') {
        (window as any).gtag('event', eventName, {
          source_page_type: 'report',
          source_slug: el.dataset.slug,
          report_format: el.dataset.format,
          cta_position: 'export_links',
        });
      }
    });
  });
</script>
