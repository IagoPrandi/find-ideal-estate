---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { BAIRROS } from '../../data/bairros';
import { LISTAS, METRICA_LABEL, rankBairros } from '../../data/listas';
import { MEDIA_DISTRITOS, N_DISTRITOS } from '../../lib/baseline';

export const getStaticPaths: GetStaticPaths = () =>
  LISTAS.map((lista) => ({ params: { slug: lista.slug }, props: { lista } }));

const { lista } = Astro.props;

const ano = new Date(`${lista.dataAtualizacao}T12:00:00`).getFullYear();
const ranked = rankBairros(BAIRROS, lista.metrica, lista.topN);
const media = MEDIA_DISTRITOS[lista.metrica];
const top = ranked[0];

const titleAno = `${lista.titulo} (${ano})`;
const h1Ano = `${lista.h1} (${ano})`;

const leadDinamico =
  `Entre os ${N_DISTRITOS} distritos de São Paulo analisados pelo BetterPlace, ${top.nome} lidera em ` +
  `${METRICA_LABEL[lista.metrica]} (índice ${top[lista.metrica]}/100), seguido por ` +
  `${ranked.slice(1, 3).map((b) => b.nome).join(' e ')}. ` +
  `O ranking é relativo entre os distritos publicados, com metodologia pública.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: titleAno,
    description: lista.descricao,
    dateModified: lista.dataAtualizacao,
    author: { '@type': 'Organization', name: 'BetterPlace' },
    publisher: {
      '@type': 'Organization',
      name: 'BetterPlace',
      url: 'https://www.betterplace.com.br',
      logo: { '@type': 'ImageObject', url: 'https://www.betterplace.com.br/favicon.svg' },
    },
    url: `https://www.betterplace.com.br/listas/${lista.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: titleAno,
    numberOfItems: ranked.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: ranked.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.nome,
      url: `https://www.betterplace.com.br/bairros/${b.slug}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: lista.faq.map((item) => ({
      '@type': 'Question',
      name: item.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: item.resposta },
    })),
  },
];
---

<Base
  title={titleAno}
  description={lista.descricao}
  canonical={`/listas/${lista.slug}`}
  dateModified={lista.dataAtualizacao}
  jsonLd={jsonLd}
  ogType="article"
  breadcrumbs={[
    { name: 'Início', url: '/' },
    { name: 'Listas', url: '/listas' },
    { name: lista.h1 },
  ]}
>
  <span class="tag">{lista.tag}</span>
  <h1>{h1Ano}</h1>

  <p class="quick-answer"><strong>Resposta rápida:</strong> {leadDinamico}</p>

  <Cta tipo="guia" posicao="inline" slug={lista.slug} />

  <h2>Ranking dos {ranked.length} distritos com mais {METRICA_LABEL[lista.metrica]}</h2>
  <ol class="ranking">
    {ranked.map((b) => (
      <li>
        <a href={`/bairros/${b.slug}`}><strong>{b.nome}</strong></a>
        {' — '}índice {b[lista.metrica]}/100
        <span class="meta"> (média dos {N_DISTRITOS} distritos analisados: {media}/100)</span>
        {b.pontosFortes[0] && <div class="ranking__nota">{b.pontosFortes[0]}</div>}
      </li>
    ))}
  </ol>

  <p class="meta">{lista.notaMetrica}</p>
  <p class="meta">
    Este ranking considera apenas os {N_DISTRITOS} distritos já publicados pelo BetterPlace — não é
    um ranking de toda a cidade. A cobertura é ampliada a cada atualização.
    <a href="/metodologia">Como os dados são calculados</a>.
  </p>

  <hr class="divider" />

  <h2>Perguntas frequentes</h2>
  {lista.faq.map((item) => (
    <>
      <h3>{item.pergunta}</h3>
      <p>{item.resposta}</p>
    </>
  ))}

  <hr class="divider" />

  <h2>Outras listas</h2>
  <ul>
    {LISTAS.filter((l) => l.slug !== lista.slug).map((l) => (
      <li><a href={`/listas/${l.slug}`}>{l.h1}</a></li>
    ))}
  </ul>

  <p class="meta">
    Atualizado em {lista.dataAtualizacao} ·
    <a href="/bairros">Todos os bairros</a> ·
    <a href="/comparar">Comparativos</a> ·
    <a href="/dados">Dataset aberto</a>
  </p>

  <Cta tipo="guia" posicao="end" slug={lista.slug} />
</Base>

<style>
  .quick-answer {
    background: var(--color-accent-light, #eff6ff);
    border-left: 4px solid var(--color-accent, #2563eb);
    padding: 0.75rem 1rem;
    border-radius: 4px;
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .ranking { margin-left: 1.25rem; }
  .ranking li { margin-bottom: 0.85rem; }
  .ranking__nota { font-size: 0.88rem; color: var(--color-muted); margin-top: 0.15rem; }
</style>
