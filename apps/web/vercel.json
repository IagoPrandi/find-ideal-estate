{
  "rewrites": [
    { "source": "/_astro/:path*", "destination": "https://betterplace-content.vercel.app/_astro/:path*" },

    { "source": "/bairros", "destination": "https://betterplace-content.vercel.app/bairros" },
    { "source": "/bairros/:path*", "destination": "https://betterplace-content.vercel.app/bairros/:path*" },

    { "source": "/comparar", "destination": "https://betterplace-content.vercel.app/comparar" },
    { "source": "/comparar/:path*", "destination": "https://betterplace-content.vercel.app/comparar/:path*" },

    { "source": "/dados", "destination": "https://betterplace-content.vercel.app/dados" },
    { "source": "/dados/:path*", "destination": "https://betterplace-content.vercel.app/dados/:path*" },

    { "source": "/relatorios", "destination": "https://betterplace-content.vercel.app/relatorios" },
    { "source": "/relatorios/:path*", "destination": "https://betterplace-content.vercel.app/relatorios/:path*" },

    { "source": "/imoveis/:path*", "destination": "https://betterplace-content.vercel.app/imoveis/:path*" },
    { "source": "/metodologia", "destination": "https://betterplace-content.vercel.app/metodologia" },

    { "source": "/robots.txt", "destination": "https://betterplace-content.vercel.app/robots.txt" },
    { "source": "/BingSiteAuth.xml", "destination": "https://betterplace-content.vercel.app/BingSiteAuth.xml" },
    { "source": "/llms.txt", "destination": "https://betterplace-content.vercel.app/llms.txt" },
    { "source": "/sitemap-index.xml", "destination": "https://betterplace-content.vercel.app/sitemap-index.xml" },
    { "source": "/sitemap-0.xml", "destination": "https://betterplace-content.vercel.app/sitemap-0.xml" },

    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
